# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Configuration (OpenAI, OpenRouter, Anthropic, etc.)
# Flora works best with Claude 3.5 Sonnet or GPT-4o
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# GitHub Configuration (for Git operations)
# Create a Personal Access Token with 'repo' scope at github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# Security
# List of Telegram User IDs allowed to access Flora (comma-separated). Highly recommended!
# You can find your ID using bots like @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# Sandboxing & Projects
# Where Flora clones projects on the server
PROJECTS_DIR=/app/projects
# Host path of projects (required if Flora runs inside Docker and needs to mount paths to sibling containers)
HOST_PROJECTS_DIR=/path/to/flora/projects
